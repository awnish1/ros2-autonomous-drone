<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">

  <world name="drone_world">

    
    <gravity>0 0 -9.81</gravity>

    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />

    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />

    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

    
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    
    <light name="sun" type="directional">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.4 0.3 -1</direction>

    </light>

    
    <model name="ground_plane">

      <static>true</static>

      <pose>0 0 -0.05 0 0 0</pose>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">

          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>

        </visual>

      </link>

    </model>

    
    <model name="quadcopter">

    
    <static>false</static>

    
    <pose>0 0 1 0 0 0</pose>

    <link name="base_link">
      
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.03</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.4 0.3 0.1</size>
          </box>
        </geometry>
      </collision>

      
      <collision name="arm_1_collision">
        <pose>0 0 0 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.75 0.035 0.035</size>
          </box>
        </geometry>
      </collision>

      
      <collision name="arm_2_collision">
        <pose>0 0 0 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>0.75 0.035 0.035</size>
          </box>
        </geometry>
      </collision>


      

      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.4 0.3 0.1</size>
          </box>
        </geometry>

        <material>
          <ambient>0.1 0.2 0.8 1</ambient>
          <diffuse>0.1 0.2 0.8 1</diffuse>
        </material>
      </visual>


      

      <visual name="arm_1">
        <pose>0 0 0 0 0 0.785398</pose>

        <geometry>
          <box>
            <size>0.75 0.035 0.035</size>
          </box>
        </geometry>

        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>


      

      <visual name="arm_2">
        <pose>0 0 0 0 0 -0.785398</pose>

        <geometry>
          <box>
            <size>0.75 0.035 0.035</size>
          </box>
        </geometry>

        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>


      

      <visual name="motor_1">
        <pose>0.265 0.265 0.05 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
      </visual>


      

      <visual name="motor_2">
        <pose>0.265 -0.265 0.05 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
      </visual>


      

      <visual name="motor_3">
        <pose>-0.265 0.265 0.05 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
      </visual>


      

      <visual name="motor_4">
        <pose>-0.265 -0.265 0.05 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
      </visual>


      

      <visual name="propeller_1">
        <pose>0.265 0.265 0.095 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.9 0.2 0.1 1</ambient>
          <diffuse>0.9 0.2 0.1 1</diffuse>
        </material>
      </visual>


      

      <visual name="propeller_2">
        <pose>0.265 -0.265 0.095 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>


      

      <visual name="propeller_3">
        <pose>-0.265 0.265 0.095 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>


      

      <visual name="propeller_4">
        <pose>-0.265 -0.265 0.095 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.9 0.2 0.1 1</ambient>
          <diffuse>0.9 0.2 0.1 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</world>

</sdf>